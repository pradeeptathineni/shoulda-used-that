{
  "$id": "https://github.com/pradeeptathineni/shoulda-used-that/blob/main/schemas/adoption-plan.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "expected_postconditions": {
      "items": {
        "type": "string"
      },
      "title": "Expected Postconditions",
      "type": "array"
    },
    "mutation_state": {
      "const": "planning-only",
      "default": "planning-only",
      "title": "Mutation State",
      "type": "string"
    },
    "native_tools": {
      "default": [],
      "items": {
        "type": "string"
      },
      "title": "Native Tools",
      "type": "array"
    },
    "need": {
      "minLength": 1,
      "title": "Need",
      "type": "string"
    },
    "plan_fingerprint": {
      "title": "Plan Fingerprint",
      "type": "string"
    },
    "plan_id": {
      "title": "Plan Id",
      "type": "string"
    },
    "profile": {
      "title": "Profile",
      "type": "string"
    },
    "proposed_files": {
      "default": [],
      "items": {
        "type": "string"
      },
      "title": "Proposed Files",
      "type": "array"
    },
    "remaining_evidence": {
      "default": [],
      "items": {
        "type": "string"
      },
      "title": "Remaining Evidence",
      "type": "array"
    },
    "repository": {
      "title": "Repository",
      "type": "string"
    },
    "rollback": {
      "items": {
        "type": "string"
      },
      "title": "Rollback",
      "type": "array"
    },
    "schema_version": {
      "const": "1.0",
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "target": {
      "minLength": 1,
      "title": "Target",
      "type": "string"
    },
    "tests": {
      "default": [],
      "items": {
        "type": "string"
      },
      "title": "Tests",
      "type": "array"
    }
  },
  "required": [
    "plan_id",
    "plan_fingerprint",
    "created_at",
    "profile",
    "repository",
    "need",
    "target",
    "expected_postconditions",
    "rollback"
  ],
  "title": "AdoptionPlan",
  "type": "object"
}
