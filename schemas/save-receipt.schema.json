{
  "$defs": {
    "Disposition": {
      "enum": [
        "adopt",
        "trial",
        "reference",
        "learn",
        "watch",
        "reject",
        "build"
      ],
      "title": "Disposition",
      "type": "string"
    }
  },
  "$id": "https://github.com/pradeeptathineni/shoulda-used-that/blob/main/schemas/save-receipt.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "already_saved": {
      "items": {
        "type": "string"
      },
      "title": "Already Saved",
      "type": "array"
    },
    "created": {
      "items": {
        "type": "string"
      },
      "title": "Created",
      "type": "array"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "disposition": {
      "anyOf": [
        {
          "$ref": "#/$defs/Disposition"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "profile": {
      "title": "Profile",
      "type": "string"
    },
    "projection_plan_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Projection Plan Id"
    },
    "repositories": {
      "items": {
        "type": "string"
      },
      "title": "Repositories",
      "type": "array"
    },
    "save_id": {
      "title": "Save Id",
      "type": "string"
    },
    "schema_version": {
      "const": "1.0",
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "source_check_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Source Check Id"
    },
    "source_result_fingerprint": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Source Result Fingerprint"
    }
  },
  "required": [
    "save_id",
    "created_at",
    "profile",
    "repositories",
    "created",
    "already_saved"
  ],
  "title": "SaveReceipt",
  "type": "object"
}
