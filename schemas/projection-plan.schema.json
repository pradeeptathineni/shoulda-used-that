{
  "$defs": {
    "ProjectionOperation": {
      "additionalProperties": false,
      "properties": {
        "classification": {
          "enum": [
            "already_starred",
            "requires_star"
          ],
          "title": "Classification",
          "type": "string"
        },
        "operations": {
          "items": {
            "type": "string"
          },
          "title": "Operations",
          "type": "array"
        },
        "repository": {
          "title": "Repository",
          "type": "string"
        },
        "status": {
          "enum": [
            "planned",
            "blocked"
          ],
          "title": "Status",
          "type": "string"
        }
      },
      "required": [
        "repository",
        "classification",
        "status",
        "operations"
      ],
      "title": "ProjectionOperation",
      "type": "object"
    }
  },
  "$id": "https://github.com/pradeeptathineni/shoulda-used-that/blob/main/schemas/projection-plan.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "list_name": {
      "maxLength": 100,
      "minLength": 1,
      "title": "List Name",
      "type": "string"
    },
    "mutation_state": {
      "const": "sealed-unapplied",
      "default": "sealed-unapplied",
      "title": "Mutation State",
      "type": "string"
    },
    "operations": {
      "items": {
        "$ref": "#/$defs/ProjectionOperation"
      },
      "title": "Operations",
      "type": "array"
    },
    "plan_fingerprint": {
      "title": "Plan Fingerprint",
      "type": "string"
    },
    "plan_id": {
      "title": "Plan Id",
      "type": "string"
    },
    "profile": {
      "title": "Profile",
      "type": "string"
    },
    "schema_version": {
      "const": "1.0",
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "source_check_id": {
      "title": "Source Check Id",
      "type": "string"
    },
    "source_result_fingerprint": {
      "title": "Source Result Fingerprint",
      "type": "string"
    },
    "source_state_fingerprint": {
      "title": "Source State Fingerprint",
      "type": "string"
    }
  },
  "required": [
    "plan_id",
    "plan_fingerprint",
    "created_at",
    "profile",
    "list_name",
    "source_check_id",
    "source_result_fingerprint",
    "source_state_fingerprint",
    "operations"
  ],
  "title": "ProjectionPlan",
  "type": "object"
}
