{
  "$defs": {
    "Assessment": {
      "additionalProperties": false,
      "description": "Contextual judgment owned by exactly one problem and repository relation.",
      "properties": {
        "assessed_at": {
          "format": "date-time",
          "title": "Assessed At",
          "type": "string"
        },
        "assessment_basis": {
          "$ref": "#/$defs/AssessmentBasis"
        },
        "covers": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Covers",
          "type": "array"
        },
        "decision_state": {
          "anyOf": [
            {
              "$ref": "#/$defs/CurationDisposition"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "evidence_refs": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Evidence Refs",
          "type": "array"
        },
        "problem_id": {
          "title": "Problem Id",
          "type": "string"
        },
        "publication_state": {
          "const": "assessed",
          "default": "assessed",
          "title": "Publication State",
          "type": "string"
        },
        "reconsider_when": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Reconsider When",
          "type": "array"
        },
        "repository": {
          "title": "Repository",
          "type": "string"
        },
        "schema_version": {
          "const": "1.0",
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "unknowns": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Unknowns",
          "type": "array"
        },
        "watch": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Watch",
          "type": "array"
        }
      },
      "required": [
        "problem_id",
        "repository",
        "assessment_basis",
        "evidence_refs",
        "assessed_at"
      ],
      "title": "Assessment",
      "type": "object"
    },
    "AssessmentBasis": {
      "description": "Evidence-bearing bases that can support contextual human judgment.",
      "enum": [
        "documented-use",
        "capability-review",
        "decision-record"
      ],
      "title": "AssessmentBasis",
      "type": "string"
    },
    "Brief": {
      "additionalProperties": false,
      "description": "A deliberately small prior-art answer for exactly one concrete problem.",
      "properties": {
        "candidate_repositories": {
          "items": {
            "type": "string"
          },
          "maxItems": 5,
          "minItems": 3,
          "title": "Candidate Repositories",
          "type": "array"
        },
        "checked_at": {
          "format": "date-time",
          "title": "Checked At",
          "type": "string"
        },
        "evidence_refs": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Evidence Refs",
          "type": "array"
        },
        "problem_id": {
          "title": "Problem Id",
          "type": "string"
        },
        "schema_version": {
          "const": "1.0",
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "title": {
          "maxLength": 100,
          "minLength": 1,
          "title": "Title",
          "type": "string"
        },
        "what_appears_covered": {
          "items": {
            "type": "string"
          },
