          "title": "What Appears Covered",
          "type": "array"
        },
        "what_remains_unresolved": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "What Remains Unresolved",
          "type": "array"
        }
      },
      "required": [
        "problem_id",
        "title",
        "candidate_repositories",
        "what_appears_covered",
        "what_remains_unresolved",
        "evidence_refs",
        "checked_at"
      ],
      "title": "Brief",
      "type": "object"
    },
