          "title": "Field Classification",
          "type": "string"
        },
        "freshness_state": {
          "$ref": "#/$defs/FreshnessState"
        },
        "last_checked_at": {
          "format": "date-time",
          "title": "Last Checked At",
          "type": "string"
        },
        "latest_commit": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Latest Commit"
        },
        "latest_release": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Latest Release"
        },
        "observed_license": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Observed License"
        },
        "popularity": {
          "$ref": "#/$defs/PopularitySnapshot"
        },
        "repository": {
          "title": "Repository",
          "type": "string"
        },
        "schema_version": {
          "const": "1.0",
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "source_provenance": {
          "items": {
            "$ref": "#/$defs/SourceProvenance"
          },
          "minItems": 1,
          "title": "Source Provenance",
          "type": "array"
        },
        "url": {
          "title": "Url",
          "type": "string"
        }
      },
      "required": [
        "repository",
        "url",
        "description",
        "popularity",
        "last_checked_at",
        "freshness_state",
        "source_provenance"
      ],
      "title": "RepositoryEvidence",
      "type": "object"
    },
    "ScreeningBasis": {
      "description": "Why a candidate is retained before contextual assessment.",
      "enum": [
        "metadata-and-eligibility",
        "reviewed-use-and-prior-art",
        "legacy-migration"
      ],
      "title": "ScreeningBasis",
      "type": "string"
    },
    "SourceProvenance": {
      "additionalProperties": false,
      "properties": {
        "content_digest": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Content Digest"
        },
        "locator": {
          "minLength": 1,
          "title": "Locator",
          "type": "string"
        },
        "observed_at": {
          "format": "date-time",
          "title": "Observed At",
          "type": "string"
        },
        "source": {
          "minLength": 1,
          "title": "Source",
          "type": "string"
        }
      },
      "required": [
        "source",
        "locator",
        "observed_at"
      ],
      "title": "SourceProvenance",
      "type": "object"
    }
  },
